# Server Configuration
PORT=3005

# Persistent Data Storage (SQLite database, uploaded models, thumbnails)
# Designed for Proxmox LXC bind-mount (e.g. /opt/3d-models/data)
DATA_DIR=./data

# Session Security
SESSION_SECRET=change-this-secret-in-production

# Initial Admin Credentials (auto-seeded on first run if database is empty)
ADMIN_USER=admin
ADMIN_PASSWORD=adminpassword
